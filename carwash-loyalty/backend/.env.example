# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-side only. NEVER expose to frontend.
SUPABASE_ANON_KEY=your-anon-key

# ── Server ────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000                 # Used for CORS

# ── Apple Wallet ──────────────────────────────────────
# Obtain from Apple Developer portal:
# 1. Create a Pass Type ID (e.g. pass.com.yourcarwash.loyalty)
# 2. Download the certificate (.p12) and convert to .pem
# 3. Download WWDR intermediate cert from Apple
APPLE_PASS_TYPE_ID=pass.com.yourcarwash.loyalty
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_CERT_PATH=./certs/apple/signerCert.pem
APPLE_KEY_PATH=./certs/apple/signerKey.pem
APPLE_KEY_PASSPHRASE=your-cert-passphrase
APPLE_WWDR_PATH=./certs/apple/wwdr.pem

# ── Google Wallet ─────────────────────────────────────
# Obtain from Google Cloud Console:
# 1. Create a project, enable Google Wallet API
# 2. Create a service account, download JSON key
# 3. Get your Issuer ID from pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=your-issuer-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GOOGLE_WALLET_CLASS_ID=your-issuer-id.carwash_loyalty

# ── Optional: PassKit.io shortcut (skip Apple/Google certs in MVP) ──
PASSKIT_API_KEY=your-passkit-api-key

# ── Optional: Twilio SMS ──────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+44xxxxxxxxxx
